#!/bin/sh /etc/rc.common
# Before uhttpd (START=50) starts: keep the interface only at /cgi-bin/hyperg and rebuild
# the HyperG web root (/www-hyperg).
START=49

start() {
	/usr/libexec/hyperg/apply-web-path
	/usr/libexec/hyperg/sync-www /www /usr/share/hyperg/www-static /www-hyperg
}

stop() {
	:
}
